\section{1D Diffusion equation}
\subsection{Governing equations}
The 1D diffusion equation is given by
\begin{equation}\label{eq:dim-diffusion}
  \frac{\partial u^*}{\partial t^*} = D \frac{\partial^2 u^*}{\partial (x^*)^2}.
\end{equation}
We use the following non-dimensionalization
\begin{equation}\label{eq:u-nondim}
  u = \frac{u^*}{U},
\end{equation}
\begin{equation}\label{eq:x-nondim}
  x = \frac{x^*}{L},
\end{equation}
where $U$ and $L$ are functions of time. For the temporal coordinate, we define
\begin{equation}\label{eq:tstar-def}
  t^* = s(t),
\end{equation}
such that
\begin{equation}\label{eq:sprime}
  \frac{\mathrm{d} s}{\mathrm{d} t} = s' = \frac{L_k^2}{D},
\end{equation}
and
\begin{equation}\label{eq:dtdtstar}
\frac{\mathrm{d} t}{\mathrm{d} t^*} = \frac{D}{L_k^2}.
\end{equation}

Using the chain rule, the left-hand side of \eqref{eq:dim-diffusion} becomes
\begin{equation}\label{eq:lhs-chain}
  \frac{\partial (uU)}{\partial t^*}
  = \frac{\partial (uU)}{\partial t} \frac{\mathrm{d}t}{\mathrm{d}t^*}
  + U \frac{\partial u}{\partial x} \frac{\partial x}{\partial t} \frac{\mathrm{d}t}{\mathrm{d}t^*}.
\end{equation}
Differentiating \eqref{eq:x-nondim} with respect to $t$ at fixed $x^*$ yields
\begin{equation}\label{eq:dxdt}
  \frac{\mathrm{d}x}{\mathrm{d}t} = -\frac{x^* L_k'}{L_k^2} = -\frac{L_k'}{L_k} x.
\end{equation}
Substituting \eqref{eq:dxdt} and \eqref{eq:dtdtstar} into \eqref{eq:lhs-chain} gives
\begin{equation}\label{eq:lhs-transformed}
  \begin{aligned}
  \frac{\partial (uU)}{\partial t^*}
  &= \left( U \frac{\partial u}{\partial t} + u U' - U \frac{L_k'}{L_k} x \frac{\partial u}{\partial x} \right) \frac{D}{L_k^2} \\
  &= U \left( \frac{\partial u}{\partial t} + u \frac{U'}{U} - \frac{L_k'}{L_k} x \frac{\partial u}{\partial x} \right) \frac{D}{L_k^2}.
  \end{aligned}
\end{equation}
We now transform the right-hand side of \eqref{eq:dim-diffusion}:
\begin{equation}\label{eq:rhs-chain}
  D \frac{\partial^2 (uU)}{\partial (x^*)^2}
  = D U \frac{\partial^2 u}{\partial (x^*)^2}
  = D U \frac{\partial}{\partial x^*}\left( \frac{\partial u}{\partial x} \frac{\partial x}{\partial x^*} \right).
\end{equation}
Substituting the spatial derivative scale
\begin{equation}\label{eq:dxdxstar}
  \frac{\mathrm{d}x}{\mathrm{d}x^*} = \frac{1}{L_k},
\end{equation}
and simplifying, we obtain
\begin{equation}\label{eq:rhs-transformed}
  D \frac{\partial^2 (uU)}{\partial (x^*)^2}
  = D U \frac{\partial}{\partial x}\left( \frac{\partial u}{\partial x} \frac{1}{L_k} \right) \frac{1}{L_k}
  = \frac{DU}{L_k^2} \frac{\partial^2 u}{\partial x^2}.
\end{equation}
Equating \eqref{eq:lhs-transformed} and \eqref{eq:rhs-transformed} and dividing by
common factors, we arrive at the transformed equation:
\begin{equation}\label{eq:transformed}
  \frac{\partial u}{\partial t}
  = \frac{L_k'}{L_k} x \frac{\partial u}{\partial x}
  - \frac{U'}{U} u
  + \frac{\partial^2 u}{\partial x^2}.
\end{equation}
\par
We assume that $U$ is of the form
\begin{equation}\label{eq:U-power-form}
  U = (t^* + \alpha_U)^{\beta_U}.
\qquad
L = (t^* + \alpha_L)^{\beta_L}.
\end{equation}
It follows that
\begin{equation}\label{eq:U-ratio}
  \frac{U_{k+i}}{U_k} = \left( 1 + \frac{i\cdot\Delta t_k^*}{t_k^* + \alpha_U} \right)^{\beta_U},
  \qquad
  \frac{L_{k+i}}{L_k} = \left( 1 + \frac{i\cdot\Delta t_k^*}{t_k^* + \alpha_L} \right)^{\beta_L}.
\end{equation}
We can express $\Delta t^*$ using
\begin{equation}\label{eq:dtstar-approx}
  \Delta t_k^* = \int_{t_k}^{t_{k+1}} \frac{L^2}{D}\,\mathrm{d}t \approx \frac{\Delta t}{12 D}\left(23L_k^2 - 16L_{k-1}^2 + 5L_{k-2}^2\right).
\end{equation}
As such
\begin{equation}\label{eq:UL-ratio-expanded}
  \frac{U_{k+i}}{U_k} = \left( 1 + \frac{i\cdot \Delta t}{12 D}\frac{23L_k^2 - 16L_{k-1}^2 + 5L_{k-2}^2}{U_k^{1/ \beta_U}} \right)^{\beta_U},
  \qquad
  \frac{L_{k+i}}{L_k} = \left( 1 + \frac{i\cdot \Delta t}{12 D}\frac{23L_k^2 - 16L_{k-1}^2 + 5L_{k-2}^2}{L_k^{1/ \beta_L}} \right)^{\beta_L}.
\end{equation}
We store $\ln(U_k)$ and $\ln(L_k)$ instead of $U_k$ and $L_k$ to avoid overflow. We also perform computations in the logorithimic number system where multiplcation and division become 
addition and subtraction and addition and subtraction are given by
\begin{equation}\label{eq:log-sum-exp}
  \log_b(X+Y) = \log_b(X) + \log_b\!\bigl(1+b^{\,y-x}\bigr),
  \qquad
  \log_b(X-Y) = \log_b(X) + \log_b\!\bigl(1-b^{\,y-x}\bigr) \quad (X>Y>0),
\end{equation}
where $x=\log_b(X)$, $y=\log_b(Y)$.

\subsection{Integration}
The numerical scheme will use different operator splitting schemes which are composed of the diffusion step
\begin{equation}
  \label{eq:diff_step}
  \Phi_{\Delta t}^{(D)}(u_k) = u_k + \int_{t_k}^{t_k+\Delta t} \frac{\partial^2 u}{\partial x^2}\mathrm{d}t,
\end{equation}
and the scaling step
\begin{equation}
  \Phi_{\Delta t}^{(S)}(u_k) = u_k + \int_{t_k}^{t_{k+1}}
  \left( \frac{L'}{L} x \frac{\partial u}{\partial x} - \frac{U'}{U} u \right) \mathrm{d}t.
\end{equation}

\subsubsection{scaling operator}
evaluating $\Phi_{\Delta t}^{(S)}$ can be done by solving the following pde
\begin{equation}
  \frac{\partial u}{\partial t} = x\frac{L^\prime}{L}\frac{\partial u}{\partial x} - \frac{U^\prime}{U}u,
\end{equation}
with the method of characteristics. Along a curve $x(t)$ satisfying
\begin{equation}\label{eq:scaling-characteristic}
  \frac{\mathrm{d} x}{\mathrm{d} t} = -x \frac{L^\prime}{L},
\end{equation}
the total derivative of $u$ is
\begin{equation}
  \frac{\mathrm{d} u}{\mathrm{d} t} = \frac{\partial u}{\partial t} + \frac{\partial u}{\partial x} \frac{\mathrm{d} x}{\mathrm{d} t}
  = \frac{\partial u}{\partial t} - x \frac{L^\prime}{L} \frac{\partial u}{\partial x},
\end{equation}
so along this characteristic the PDE reduces to the ODE
\begin{equation}\label{eq:scaling-ode}
  \frac{\mathrm{d} u}{\mathrm{d} t} = -\frac{U^\prime}{U} u.
\end{equation}

Integrating \eqref{eq:scaling-characteristic} from $t_k$ to $t_{k+1}$ gives
\begin{equation}
  \ln x_{k+1} - \ln x_k = -\bigl[\ln L_{k+1} - \ln L_k\bigr]
  \quad\Longrightarrow\quad
  x_{k+1} = x_k\, \frac{L_k}{L_{k+1}},
\end{equation}
so that the characteristic arriving at $x_{k+1}$ originated at
\begin{equation}\label{eq:scaling-origin}
  x_k = x_{k+1}\, \frac{L_{k+1}}{L_k}.
\end{equation}
Integrating \eqref{eq:scaling-ode} in the same way gives
\begin{equation}
  u_{k+1} = u_k\, \frac{U_k}{U_{k+1}}.
\end{equation}
Combining this with the initial condition $u_k(x)$ and the
characteristic origin \eqref{eq:scaling-origin} gives the solution of the
PDE at $t_{k+1} = t_k + \Delta t$, i.e.\ the scaling operator in closed form,
\begin{equation}\label{eq:scaling-operator}
  \Phi_{\Delta t}^{(S)}(u_k)(x) = u_{k+1}(x) = \frac{U_k}{U_{k+1}}\, u_k\!\left( x\, \frac{L_{k+1}}{L_k} \right).
\end{equation}
Substituting in
\begin{align}
  \tilde{U}_{k+1} = \frac{U_{k+1}}{U_{k}},\\
  \tilde{L}_{k+1} = \frac{L_{k+1}}{L_k},
\end{align}
we have
\begin{equation}
  \label{eq:scaleStep}
  \Phi_{\Delta t}^{(S)}(u_k)(x) = u_{k+1}(x) = \frac{1}{\tilde{U}_{k+1}}u_k\!\left( x\, \tilde{L}_{k+1} \right).
\end{equation}
\subsubsection{Specteral interpolation}
From Eq.~\eqref{eq:scaleStep}, for a real-valued field $u_k$, $u_{k+1}$ can be computed using spectral interpolation via the non-negative frequency components obtained from a real Fast Fourier Transform ($\mathrm{RFFT}$):
\begin{equation}
  \begin{split}
    u_{k+1}(x) = \frac{1}{\tilde{U}_{k+1}}\biggl\{ &\hat{u}_0^{(k)}
      + 2 \sum_{j=1}^{N/2-1} \biggl[ \operatorname{Re}\bigl(\hat{u}_j^{(k)}\bigr) \cos\left(\frac{2\pi j \tilde{L}_{k+1} x}{H}\right) \\
      &\qquad - \operatorname{Im}\bigl(\hat{u}_j^{(k)}\bigr) \sin\left(\frac{2\pi j \tilde{L}_{k+1} x}{H}\right) \biggr] \\
      &+ \hat{u}_{N/2}^{(k)} \cos\left(\frac{\pi N \tilde{L}_{k+1} x}{H}\right) \biggr\},
  \end{split}
\end{equation}
where $\hat{u}_j^{(k)} = \frac{1}{N} \mathrm{RFFT}(u_k)_j$ for $j = 0, 1, \dots, N/2$, the Nyquist term at $j = N/2$ is included only if $N$ is even, and $H$ is the fixed physical domain length of \S\ref{sssec:domain-setup}.
\subsubsection{Moment constraints}\label{sssec:moment-constraints}
$\tilde{U}_{k+1}$ and $\tilde{L}_{k+1}$ are set such that the resulting solution has a specific first order moment, $M_0$ and second order moment, $M_2$. Denote the
moments of the input $u_k$ as
\begin{equation}
  M_0^* = \int u_k \mathrm{d}x,
\end{equation}
and
\begin{equation}
  M_2^* = \int x^2 u_k \mathrm{d}x.
\end{equation}
The requriment for the first moment
\begin{equation}
  M_0 = \int \frac{1}{\tilde{U}_{k+1}}u_k\!\left( x\, \tilde{L}_{k+1} \right)\mathrm{d}x = \frac{1}{\tilde{U}_{k+1}\tilde{L}_{k+1}}M_0^*.
\end{equation}
The second moment requirment is
\begin{equation}\label{eq:M2-req}
  M_2 = \frac{1}{M_0}\int x^2\frac{1}{\tilde{U}_{k+1}}u_k\!\left( x\, \tilde{L}_{k+1} \right)\mathrm{d}x.
\end{equation}
Substituting $y = x\, \tilde{L}_{k+1}$ in the integral gives
\begin{equation}
  \int x^2\, \frac{1}{\tilde{U}_{k+1}} u_k\!\left( x\, \tilde{L}_{k+1} \right) \mathrm{d}x
  = \frac{1}{\tilde{U}_{k+1}\tilde{L}_{k+1}^3} \int y^2 u_k(y)\, \mathrm{d}y
  = \frac{M_2^*}{\tilde{U}_{k+1}\tilde{L}_{k+1}^3},
\end{equation}
so that \eqref{eq:M2-req} becomes
\begin{equation}
  M_2 = \frac{M_2^*}{M_0\, \tilde{U}_{k+1}\tilde{L}_{k+1}^3}.
\end{equation}
Using the first-moment requirement in the form $M_0\, \tilde{U}_{k+1}\tilde{L}_{k+1} = M_0^*$ to eliminate $\tilde{U}_{k+1}$, this reduces to
\begin{equation}
  M_2 = \frac{M_2^*}{M_0^*\, \tilde{L}_{k+1}^2},
\end{equation}
which gives
\begin{equation}\label{eq:Ltilde-solution}
  \tilde{L}_{k+1} = \sqrt{\frac{M_2^*}{M_0^*\, M_2}}.
\end{equation}
Substituting \eqref{eq:Ltilde-solution} back into the first-moment requirement $\tilde{U}_{k+1}\tilde{L}_{k+1} = M_0^*/M_0$ then yields
\begin{equation}\label{eq:Utilde-solution}
  \tilde{U}_{k+1} = \frac{M_0^*}{M_0\, \tilde{L}_{k+1}}
  = \frac{(M_0^*)^{3/2}}{M_0}\sqrt{\frac{M_2}{M_2^*}}.
\end{equation}
\subsection{Algorithm}

\subsubsection{Domain, grid, and notation}\label{sssec:domain-setup}
The spatial domain is periodic with a fixed physical length $H$ and $N$ grid
points. The domain is centered at the origin,
$x \in [-H/2, H/2)$, with uniform spacing $\Delta x = H/N$ and grid points
\begin{equation}\label{eq:grid}
  x_n = -\frac{H}{2} + n\, \Delta x, \qquad n = 0, 1, \dots, N-1
\end{equation}
Every integral over $x$ below -- in
particular the moments $M_0, M_2, M_0^*, M_2^*$ -- is approximated by the
Riemann sum,
\begin{equation}
  \int f(x)\,\mathrm{d}x \approx \Delta x \sum_{n=0}^{N-1} f(x_n),
\end{equation}
on this grid. 
\subsubsection{Initialization}
A run is specified by the initial field $u_0(x_n)$, the diffusivity $D$, the
domain parameters $H, N$, a fixed nondimensional timestep $\Delta t$, a time
horizon $T_{\mathrm{end}}$, the splitting scheme
$\mathit{scheme} \in \{\textsc{LieTrotter}, \textsc{Strang}\}$
(\S\ref{sssec:lie-trotter}, \S\ref{sssec:strang}), and initial guesses
$\beta_U^{(0)}, \beta_L^{(0)}$, which only seed the bracket of the first
root-find for $\beta_U, \beta_L$ (\S\ref{sssec:beta-estimation}). From these:
\begin{itemize}
  \item The number of steps is $N_{\mathrm{steps}} = \lceil T_{\mathrm{end}}/\Delta t \rceil$.
  \item The self-similar frame is initialized at the initial condition
  itself, $L_0 = U_0 = 1$, i.e.\ $\ln L_0 = \ln U_0 = 0$.
  \item The \emph{target} moments $M_0, M_2$ used in the moment constraints
  of \S\ref{sssec:moment-constraints} are fixed once, from $u_0$ itself,
  \begin{equation}\label{eq:target-moments}
    M_0 = \Delta x \sum_n u_0(x_n), \qquad M_2 = \Delta x \sum_n x_n^2\, u_0(x_n).
  \end{equation}
  \item The flag $\beta_{\mathrm{ok}}$, which records whether the current
  $\beta_U, \beta_L$ are usable by \textsc{Strang}, starts as
  $\beta_{\mathrm{ok}} = \text{false}$.
\end{itemize}

\subsubsection{Top-level integrator}\label{sssec:top-level-integrator}
\begin{algorithm}[H]
\caption{Top-level integrator}
\begin{algorithmic}[1]
\Require $u_0$, $D$, $H$, $N$, $\Delta t$, $T_{\mathrm{end}}$, $\mathit{scheme}$, $\beta_U^{(0)}$, $\beta_L^{(0)}$
\State $N_{\mathrm{steps}} \gets \lceil T_{\mathrm{end}}/\Delta t \rceil$
\State $\ln U_0 \gets 0$, $\ln L_0 \gets 0$
\State Compute target moments $M_0, M_2$ from $u_0$ via \eqref{eq:target-moments}
\State $\beta_U \gets \beta_U^{(0)}$, $\beta_L \gets \beta_L^{(0)}$, $\beta_{\mathrm{ok}} \gets \text{false}$
\State Store $(u_0, \ln U_0, \ln L_0, \beta_U, \beta_L, \beta_{\mathrm{ok}})$
\For{$k = 0, 1, \dots, N_{\mathrm{steps}}-1$}
  \If{$\mathit{scheme} = \textsc{Strang}$ \textbf{and} $\beta_{\mathrm{ok}}$}
    \State $(u_{k+1}, \ln U_{k+1}, \ln L_{k+1}) \gets \Call{Strang}{u_k, \ln U_k, \ln L_{k-2:k}, \beta_U, \beta_L}$ \Comment{\S\ref{sssec:strang}}
  \Else
    \State $(u_{k+1}, \ln U_{k+1}, \ln L_{k+1}) \gets \Call{LieTrotter}{u_k, \ln U_k, \ln L_k}$ \Comment{\S\ref{sssec:lie-trotter}}
  \EndIf
  \State $u_{k+1}(x_0) \gets 0$;\ \ $u_{k+1}(x_{N-1}) \gets 0$ \Comment{zero the two edge grid points}
  \If{$k+1 \geq 3$}
    \State $(\beta_U, \beta_L, \beta_{\mathrm{ok}}) \gets \Call{EstimateBeta}{\ln U_{k:k+1}, \ln L_{k-2:k+1}, \beta_U, \beta_L}$ \Comment{\S\ref{sssec:beta-estimation}}
  \EndIf
  \State Store $(u_{k+1}, \ln U_{k+1}, \ln L_{k+1}, \beta_U, \beta_L, \beta_{\mathrm{ok}})$
\EndFor
\end{algorithmic}
\end{algorithm}
Throughout, all arithmetic on $U_k, L_k$ (which can be extremely large or
small) is done in log space -- adding and subtracting logarithms rather than
multiplying and dividing the values themselves -- with exponentiation
deferred until a final value is actually needed (e.g.\ for output), to avoid
overflow or underflow. An index range abbreviates the corresponding tuple of
stored values, e.g.\ $\ln L_{k-2:k} = (\ln L_{k-2}, \ln L_{k-1}, \ln L_k)$.
The run constants $D, \Delta t, H, N, M_0, M_2$ are visible to every
subroutine and are omitted from their signatures.

The run parameter $\mathit{scheme}$ selects the step function. \textsc{Strang}
needs usable estimates of $\beta_U, \beta_L$, so the loop falls back to
\textsc{LieTrotter} whenever $\beta_{\mathrm{ok}}$ is false. This is always
the case for the first three steps $k = 0, 1, 2$: the first $\beta$ update
needs four stored states, so it first runs at the end of step $k = 2$. It is
also the case for every step that follows a failed $\beta$ update
(\S\ref{sssec:beta-estimation}), until a later update succeeds. The $\beta$
update itself runs regardless of $\mathit{scheme}$; under
$\mathit{scheme} = \textsc{LieTrotter}$ the estimates are diagnostic only.

\subsubsection{Substeps}\label{sssec:substeps}
Both splitting schemes are assembled from the four substeps below. None of
them touches the edge grid points, which are handled only by the top-level
loop.

\paragraph{\textsc{Diffuse}$(u, \Delta t)$.}
Because the diffusion term in \eqref{eq:transformed} has unit coefficient in
the nondimensional time $t$, $\Phi_{\Delta t}^{(D)}$
(Eq.~\eqref{eq:diff_step}) has the closed-form spectral solution
\begin{equation}\label{eq:diffusion-propagator}
  \hat u_j^{(D)} = \hat u_j\, e^{-k_j^2 \Delta t}, \qquad k_j = \frac{2\pi j}{H}, \quad j = 0, \dots, \left\lfloor N/2 \right\rfloor,
\end{equation}
where $\hat u_j = \mathrm{RFFT}(u)_j$: this is an exact one-shot spectral
propagator, not an approximate time-marching scheme, so no sub-stepping or
implicit solve is needed. Inverse-transforming gives the diffused field
$u^{(D)}(x_n)$.

\paragraph{\textsc{Scale}$(u, \ln \tilde U, \ln \tilde L)$.}
Applies the scaling operator \eqref{eq:scaleStep} with prescribed ratios
$\tilde U, \tilde L$, returning $\tilde U^{-1} u(x_n \tilde L)$ at each grid
point $x_n$. It is evaluated with the spectral interpolation formula
following Eq.~\eqref{eq:scaleStep}, using the RFFT coefficients of $u$. Here,
and wherever the substeps are used, $\tilde U$ and $\tilde L$ denote the
ratio of $U$, respectively $L$, after the substep to its value before it.
Inside a Lie--Trotter step this is $\tilde U_{k+1} = U_{k+1}/U_k$ of
\S\ref{sssec:moment-constraints}; inside a Strang step it is a ratio across a
half step, $U_{k+1/2}/U_k$ or $U_{k+1}/U_{k+1/2}$ (\S\ref{sssec:strang}).

\paragraph{\textsc{ConstrainedScale}$(u, \ln U, \ln L)$.}
Rescales $u$ so that the result has the fixed target moments $M_0, M_2$ of
\eqref{eq:target-moments}, and advances the log-scale state accordingly:
\begin{enumerate}
  \item \textbf{Moments of the input,}
  \begin{equation}\label{eq:actual-moments}
    M_0^* = \Delta x \sum_n u(x_n), \qquad M_2^* = \Delta x \sum_n x_n^2\, u(x_n).
  \end{equation}
  \item \textbf{Ratios from the moment constraints}
  (\S\ref{sssec:moment-constraints}),
  \begin{equation}\label{eq:step-scale-factors}
    \tilde L = \sqrt{\frac{M_2^*}{M_0^* M_2}}, \qquad
    \tilde U = \frac{(M_0^*)^{3/2}}{M_0}\sqrt{\frac{M_2}{M_2^*}}.
  \end{equation}
  \item \textbf{Rescale,} $u' = \textsc{Scale}(u, \ln \tilde U, \ln \tilde L)$.
  \item \textbf{Return} $u'$ together with the advanced state
  $\ln U + \ln \tilde U$, $\ln L + \ln \tilde L$.
\end{enumerate}
No time increment enters \textsc{ConstrainedScale}: the ratios are fixed by
the moments of the field it is given, not by the elapsed time. The same
substep therefore serves as the full scaling step of Lie--Trotter and as the
closing scaling half step of Strang.

\paragraph{\textsc{PredictScale}$(i, \ln U_k, \ln L_{k-2:k}, \beta_U, \beta_L)$.}
Predicts the ratios over the fraction $i$ of step $k$ from the power-law form
\eqref{eq:U-power-form}, rather than from moments. Writing
\eqref{eq:dtstar-approx} in log space,
\begin{equation}\label{eq:ln-dtstar}
  \ln \Delta t_k^* = \ln\frac{\Delta t}{12D} + \ln\!\left(23\, e^{2\ln L_k} - 16\, e^{2\ln L_{k-1}} + 5\, e^{2\ln L_{k-2}}\right),
\end{equation}
with the sum evaluated via \eqref{eq:log-sum-exp}, and taking the logarithm
of \eqref{eq:UL-ratio-expanded} gives, for $X \in \{U, L\}$,
\begin{equation}\label{eq:G-def}
  \ln\frac{X_{k+i}}{X_k} = G_X(i, \beta_X; k),
  \qquad
  G_X(i, \beta; k) = \beta \ln\!\left(1 + \exp\!\left(\ln i + \ln \Delta t_k^* - \frac{\ln X_k}{\beta}\right)\right).
\end{equation}
\textsc{PredictScale} returns
$\bigl(G_U(i, \beta_U; k),\, G_L(i, \beta_L; k)\bigr)$. The same function
$G_X$ is inverted for $\beta$ in \S\ref{sssec:beta-estimation}.

\subsubsection{\textsc{LieTrotter}: Lie--Trotter splitting}\label{sssec:lie-trotter}
A Lie--Trotter step composes a full diffusion step with a full scaling step,
$u_{k+1} = \Phi_{\Delta t}^{(S)}\bigl(\Phi_{\Delta t}^{(D)}(u_k)\bigr)$, with
the scaling ratios fixed by the moment constraints. It uses no estimate of
$\beta_U, \beta_L$, so it is valid from the first step. It is written for a
general input state $(u, \ln U, \ln L)$ rather than only a stored state
$(u_k, \ln U_k, \ln L_k)$, so that \textsc{Strang} can call it on a
half-stepped state.
\begin{algorithm}[H]
\caption{Lie--Trotter step}
\begin{algorithmic}[1]
\Function{LieTrotter}{$u, \ln U, \ln L$}
  \State $u^{(D)} \gets \Call{Diffuse}{u, \Delta t}$ \Comment{\eqref{eq:diffusion-propagator}}
  \State \Return $\Call{ConstrainedScale}{u^{(D)}, \ln U, \ln L}$ \Comment{\S\ref{sssec:substeps}}
\EndFunction
\end{algorithmic}
\end{algorithm}

\subsubsection{\textsc{Strang}: Strang splitting}\label{sssec:strang}
A Strang step is the symmetric composition
\begin{equation}\label{eq:strang-composition}
  u_{k+1} = \Phi_{\Delta t/2}^{(S)}\Bigl(\Phi_{\Delta t}^{(D)}\bigl(\Phi_{\Delta t/2}^{(S)}(u_k)\bigr)\Bigr)
\end{equation}
of a scaling half step, a full diffusion step, and a second scaling half
step. The last two of these are exactly a Lie--Trotter step -- a full
diffusion step followed by a scaling step whose ratios come from the moment
constraints -- so \textsc{Strang} is a predicted scaling half step followed
by a call to \textsc{LieTrotter}.
\begin{algorithm}[H]
\caption{Strang step}
\begin{algorithmic}[1]
\Function{Strang}{$u_k, \ln U_k, \ln L_{k-2:k}, \beta_U, \beta_L$}
  \State $\bigl(\ln (U_{k+1/2}/U_k),\, \ln (L_{k+1/2}/L_k)\bigr) \gets \Call{PredictScale}{\tfrac12, \ln U_k, \ln L_{k-2:k}, \beta_U, \beta_L}$ \Comment{\eqref{eq:strang-predict}}
  \State $u_{k+1/2} \gets \Call{Scale}{u_k, \ln (U_{k+1/2}/U_k), \ln (L_{k+1/2}/L_k)}$
  \State $\ln U_{k+1/2} \gets \ln U_k + \ln (U_{k+1/2}/U_k)$;\ \ $\ln L_{k+1/2} \gets \ln L_k + \ln (L_{k+1/2}/L_k)$
  \State \Return $\Call{LieTrotter}{u_{k+1/2}, \ln U_{k+1/2}, \ln L_{k+1/2}}$ \Comment{\S\ref{sssec:lie-trotter}}
\EndFunction
\end{algorithmic}
\end{algorithm}
No moments constrain the state at $t_k + \Delta t/2$, so the first scaling
half step takes its ratios from the current power-law estimates, via
\textsc{PredictScale} with $i = 1/2$:
\begin{equation}\label{eq:strang-predict}
  \ln\frac{U_{k+1/2}}{U_k} = G_U\!\left(\tfrac12, \beta_U; k\right), \qquad
  \ln\frac{L_{k+1/2}}{L_k} = G_L\!\left(\tfrac12, \beta_L; k\right).
\end{equation}
The call to \textsc{LieTrotter} then diffuses $u_{k+1/2}$ over the full
$\Delta t$, and its \textsc{ConstrainedScale} substep -- the second scaling
half step -- sets $U_{k+1}/U_{k+1/2}$ and $L_{k+1}/L_{k+1/2}$ so that
$u_{k+1}$ satisfies the moment constraints. The half-step state
$(u_{k+1/2}, \ln U_{k+1/2}, \ln L_{k+1/2})$ is internal to the step and is not
stored. The top-level loop calls \textsc{Strang} only when
$\beta_{\mathrm{ok}}$ is true (\S\ref{sssec:top-level-integrator}), which
guarantees that $\beta_U, \beta_L$ were fitted to the stored history at the
end of the previous step and that $\ln L_{k-2}$ exists.

\subsubsection{\textsc{EstimateBeta}: estimating \texorpdfstring{$\beta_U$}{beta\_U} and \texorpdfstring{$\beta_L$}{beta\_L}}\label{sssec:beta-estimation}
After every step with $k+1 \geq 3$, regardless of $\mathit{scheme}$,
$\beta_U$ and $\beta_L$ are re-estimated from the log-scale history. Four
stored states are needed: $\ln X_k$ and $\ln X_{k+1}$ for the ratio, and
$\ln L_{k-2:k}$ for $\Delta t_k^*$. The update inverts the function $G_X$ of
\eqref{eq:G-def} with $i = 1$, the same function that \textsc{PredictScale}
evaluates forward with $i = 1/2$:
\begin{equation}\label{eq:beta-U-rootfind}
  G_U(1, \beta_U; k) = \ln U_{k+1} - \ln U_k,
\end{equation}
and identically with $U \to L$ for $\beta_L$. Each of
\eqref{eq:beta-U-rootfind} and its $L$-counterpart is a single scalar
equation in a single unknown ($\beta_U$, resp.\ $\beta_L$), solved by
\texttt{brentq}; the implementer will need to choose a bracketing interval
(e.g.\ centered on the previous $\beta_U, \beta_L$ estimate -- on
$\beta_U^{(0)}, \beta_L^{(0)}$ for the first update -- widened adaptively if
it fails to bracket a root).

If both root-finds succeed, \textsc{EstimateBeta} returns the new
$\beta_U, \beta_L$ with $\beta_{\mathrm{ok}} = \text{true}$. If either fails
to bracket a root even after widening, the failed estimate keeps its previous
value (which seeds the next bracket), and \textsc{EstimateBeta} returns
$\beta_{\mathrm{ok}} = \text{false}$, so the next step falls back to
\textsc{LieTrotter}. Before $k+1 \geq 3$ no update is made: $\beta_U, \beta_L$
stay at $\beta_U^{(0)}, \beta_L^{(0)}$ and $\beta_{\mathrm{ok}}$ stays false.
\section{Post-processing}
Assume that $L$ and $U$ are of the form
\begin{equation}\label{eq:L-form}
  L = (t^* + a_L)^{b_L},
\end{equation}
and
\begin{equation}\label{eq:U-form}
  U = (t^* + a_U)^{b_U}.
\end{equation}

Define
\begin{equation}\label{eq:logs}
  \mathcal{L}_k = \ln L_k, \qquad \mathcal{U}_k = \ln U_k,
\end{equation}
together with the per-step log-ratios
\begin{equation}\label{eq:log-ratios}
  \ell_k = \ln L_{k+1} - \ln L_k, \qquad \lambda_k = \ln U_{k+1} - \ln U_k,
\end{equation}
which for a Lie--Trotter step equal $\ln \tilde{L}_{k+1}$ and
$\ln \tilde{U}_{k+1}$, and for a Strang step combine both half-step ratios.
\begin{equation}\label{eq:cumsum}
  \mathcal{L}_k = \mathcal{L}_0 + \sum_{i=1}^{k} \ell_i = \ln(L_k),
  \qquad
  \mathcal{U}_k = \mathcal{U}_0 + \sum_{i=1}^{k} \lambda_i = \ln(U_k).
\end{equation}
grows only linearly in $k$; unlike $L_k$ and $U_k$ themselves, $\mathcal{L}_k$ and $\mathcal{U}_k$ never
overflow.

Differentiating \eqref{eq:L-form} and \eqref{eq:U-form} with respect to $t^*$ gives
\begin{equation}\label{eq:tstar-ag}
  t^* + a_L = L^{1/b_L},
  \qquad
  t^* + a_U = U^{1/b_U}.
\end{equation}
By the chain rule
\begin{equation}
  \alpha = \frac{\frac{\mathrm{d}L}{\mathrm{d}t^*}\frac{\mathrm{d}t^*}{\mathrm{d}t}}{L} = \frac{b_L}{t^* + a_L}\frac{L^2}{D}.
\end{equation}
Substituting \eqref{eq:tstar-ag}
\begin{equation}\label{eq:alpha-L}
  \alpha = \frac{b_L}{D} \, L^{\,2 - 1/b_L}.
\end{equation}
The same steps applied to $\beta$ give
\begin{equation}\label{eq:beta-LU}
  \beta = \frac{b_U}{D} \, L^{2} U^{-1/b_U}.
\end{equation}
Taking logarithms
\begin{equation}\label{eq:alpha-log}
  \ln \alpha_k = \ln \frac{b_L}{D} + \left( 2 - \frac{1}{b_L} \right) \mathcal{L}_k,
\end{equation}
\begin{equation}\label{eq:beta-log}
  \ln \beta_k = \ln \frac{b_U}{D} + 2 \mathcal{L}_k - \frac{\mathcal{U}_k}{b_U}.
\end{equation}
Finally, $\alpha_k$ and $\beta_k$ are estimated directly from the log-ratios already in hand,
without any finite difference of $L_k$ or $U_k$ themselves,
\begin{equation}\label{eq:alpha-beta-fd}
  \alpha_k \approx \frac{\ell_k}{\Delta t}, \qquad \beta_k \approx \frac{\lambda_k}{\Delta t}.
\end{equation}
By fitting curves to Eq.~\eqref{eq:alpha-log} and Eq.~\eqref{eq:beta-log} we can compute $a_L$, $a_U$, $b_L$, and $b_U$.


