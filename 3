\section{Navier--Stokes}
Dimensional incompressible Navier--Stokes equations,
\begin{equation}\label{eq:ns-momentum}
  \frac{\partial u_i^*}{\partial t^*} + u_j^* \frac{\partial u_i^*}{\partial x_j^*}= -\frac{1}{\rho}\frac{\partial p^*}{\partial x_i^*} + \nu \frac{\partial^2 u_i^*}{\partial x_j^* \partial x_j^*},
\end{equation}
together with the continuity equation,
\begin{equation}\label{eq:ns-continuity}
  \frac{\partial u_i^*}{\partial x_i^*} = 0.
\end{equation}
We introduce the following nondimensionalization, with velocity and length
scales $U$ and $L$ taken to be functions of $t$:
\begin{align}
  u_i &= \frac{u_i^*}{U}, \\
  x_i &= \frac{x_i^*}{L}, \\
  p &= \frac{p^*}{\rho U^2}, \\
  \frac{\mathrm{d}t}{\mathrm{d}t^*} &= \frac{U}{L}. \label{eq:ns-dtdtstar}
\end{align}
We will also need, for each component $j$,
\begin{equation}\label{eq:ns-dxdt}
  \frac{\mathrm{d} x_j}{\mathrm{d} t} = -x_j^*\frac{L^\prime}{L^2} = - x_j \frac{L^\prime}{L},
\end{equation}
where prime denotes differentiation with respect to $t$.
Substituting this nondimensionalization and proceeding term by term, the
time-derivative term becomes
\begin{equation}\label{eq:ns-chainrule}
  \frac{\partial u_i^*}{\partial t^*} = \left(\frac{\mathrm{d} U}{\mathrm{d} t}\frac{\mathrm{d} t}{\mathrm{d}t^*}\right)u_i + U \left(\frac{\partial u_i}{\partial t}\frac{\mathrm{d}t}{\mathrm{d}t^*}
  + \frac{\partial u_i}{\partial x_j}\frac{\mathrm{d} x_j}{\mathrm{d} t} \frac{\mathrm{d} t}{\mathrm{d}t^*}\right),
\end{equation}
 Substituting \eqref{eq:ns-dtdtstar} and
\eqref{eq:ns-dxdt}, this becomes
\begin{equation}\label{eq:ns-final}
   \frac{\partial u_i^*}{\partial t^*} = U^\prime \frac{U}{L}u_i + U \left(\frac{\partial u_i}{\partial t}\frac{U}{L} - \frac{\partial u_i}{\partial x_j} x_j \frac{L^\prime}{L} \frac{U}{L}\right).
\end{equation}

The convection term is
\begin{equation}\label{eq:ns-convection}
  u_j^* \frac{\partial u_i^*}{\partial x_j^*} = \frac{U^2}{L} u_j \frac{\partial u_i}{\partial x_j}.
\end{equation}
The pressure term is
\begin{equation}\label{eq:ns-pressure}
  \frac{1}{\rho}\frac{\partial p^*}{\partial x_i^*} = \frac{U^2}{L} \frac{\partial p}{\partial x_i}.
\end{equation}
The viscous term is
\begin{equation}\label{eq:ns-viscous}
  \nu \frac{\partial^2 u_i^*}{\partial x_j^* \partial x_j^*} = \frac{\nu U}{L^2}\frac{\partial^2 u_i}{\partial x_j \partial x_j}.
\end{equation}

Substituting \eqref{eq:ns-final}, \eqref{eq:ns-convection}, \eqref{eq:ns-pressure},
and \eqref{eq:ns-viscous} into \eqref{eq:ns-momentum} gives
\begin{equation}\label{eq:ns-assembled}
  \frac{U U^\prime}{L} u_i
  + \frac{U^2}{L}\frac{\partial u_i}{\partial t}
  - \frac{U^2}{L}\frac{L^\prime}{L} x_j \frac{\partial u_i}{\partial x_j}
  + \frac{U^2}{L} u_j \frac{\partial u_i}{\partial x_j}
  = -\frac{U^2}{L} \frac{\partial p}{\partial x_i}
  + \frac{\nu U}{L^2} \frac{\partial^2 u_i}{\partial x_j \partial x_j}.
\end{equation}
Dividing through by $U^2/L$ and introducing the instantaneous Reynolds number
\begin{equation}\label{eq:ns-reynolds}
  Re = \frac{UL}{\nu},
\end{equation}
gives the nondimensional momentum equation
\begin{equation}\label{eq:ns-nondim-momentum-base}
  \frac{\partial u_i}{\partial t}
  = \frac{L^\prime}{L} x_j \frac{\partial u_i}{\partial x_j}
  - \frac{U^\prime}{U} u_i
  - u_j \frac{\partial u_i}{\partial x_j}
  - \frac{\partial p}{\partial x_i}
  + \frac{1}{Re} \frac{\partial^2 u_i}{\partial x_j \partial x_j}.
\end{equation}
The dimensional continuity equation is simply
\begin{equation}\label{eq:ns-nondim-continuity}
  \frac{\partial u_i}{\partial x_i} = 0.
\end{equation}
\subsection{Viscosity}
Let the kinemetic viscosity be given by
\begin{equation}
  \nu = \nu_{\mathrm{turb}} + \nu_{\mathrm{mol}},
\end{equation}
where $\nu_{\mathrm{mol}}$ is the molecular viscosity and $\nu_{\mathrm{turb}}$ is turbulent viscosity from underresolved eddies which is approximated as
\begin{equation}
  \nu_{\mathrm{turb}} = \Delta \cdot U L,
\end{equation}
where $\Delta$ is a paramter related to the resolution of the mesh. Looking at the limit of infinite Reynolds number, where $\nu_{\mathrm{mol} = 0}$ the momentum equation is \label{eq:ns-nondim-momentum-base}
\begin{equation}\label{eq:ns-nondim-momentum}
  \frac{\partial u_i}{\partial t}
  = \frac{L^\prime}{L} x_j \frac{\partial u_i}{\partial x_j}
  - \frac{U^\prime}{U} u_i
  - u_j \frac{\partial u_i}{\partial x_j}
  - \frac{\partial p}{\partial x_i}
  + \Delta \cdot \frac{\partial^2 u_i}{\partial x_j \partial x_j}.
\end{equation}


\subsection{Fourier representation}
using the $\widehat{\cdot}$ do denote a spatial fourier transform
\begin{equation}\label{eq:ns-fourier-convention}
  \hat{u}_i(\mathbf{k}) = \int u_i(\mathbf{x})\, e^{-\mathrm{i} k_j x_j}\, \mathrm{d}\mathbf{x}.
\end{equation}
The viscous term becomes
\begin{equation}\label{eq:ns-fourier-viscous}
  \widehat{\frac{\partial^2 u_i}{\partial x_j \partial x_j}} = -k^2 \hat{u}_i,
\end{equation}
and the pressure gradient becomes
\begin{equation}\label{eq:ns-fourier-pressure}
  \widehat{\frac{\partial p}{\partial x_i}} = \mathrm{i} k_i \hat{p}.
\end{equation}
The convective term
\begin{equation}\label{eq:ns-fourier-convection}
  \hat{N}_i = \widehat{u_j \frac{\partial u_i}{\partial x_j}},
\end{equation}
will be evaluated pseudo-spectrally.
Writing the spread scaling term in conservative form 
\begin{equation}\label{eq:ns-scaling-divform}
  x_j \frac{\partial u_i}{\partial x_j} = \frac{\partial}{\partial x_j}\left( x_j u_i \right) - 3\, u_i,
\end{equation}
so that
\begin{equation}\label{eq:ns-fourier-scaling}
  \widehat{x_j \frac{\partial u_i}{\partial x_j}}
  = \mathrm{i} k_j \left( \mathrm{i} \frac{\partial \hat{u}_i}{\partial k_j} \right) - 3\, \hat{u}_i
  = -\left( k_j \frac{\partial \hat{u}_i}{\partial k_j} + 3\, \hat{u}_i \right).
\end{equation}
Collecting \eqref{eq:ns-fourier-viscous}--\eqref{eq:ns-fourier-scaling},
the transform of \eqref{eq:ns-nondim-momentum} is
\begin{equation}\label{eq:ns-nondim-momentum-fourier}
  \frac{\partial \hat{u}_i}{\partial t}
  = -\frac{L^\prime}{L} \left( k_j \frac{\partial \hat{u}_i}{\partial k_j} + 3\, \hat{u}_i \right)
  - \frac{U^\prime}{U} \hat{u}_i
  - \hat{N}_i
  - \mathrm{i} k_i \hat{p}
  - \Delta \cdot k^2 \hat{u}_i,
\end{equation}
and the transform of the continuity equation
\eqref{eq:ns-nondim-continuity} is
\begin{equation}\label{eq:ns-fourier-continuity}
  k_i \hat{u}_i = 0.
\end{equation}
\par
Contracting \eqref{eq:ns-nondim-momentum-fourier} with $k_i$ and using the continuity constraint gives
\begin{equation}\label{eq:ns-pressure-contracted}
  0 = -\frac{L^\prime}{L} \left( k_i k_j \frac{\partial \hat{u}_i}{\partial k_j} + d\, k_i \hat{u}_i \right)
  - \frac{U^\prime}{U} k_i \hat{u}_i
  - k_i \hat{N}_i
  - \mathrm{i} k^2 \hat{p}
  - \Delta \cdot k^2 k_i \hat{u}_i.
\end{equation}
The remaining scaling contribution also
vanishes: differentiating \eqref{eq:ns-fourier-continuity} with respect to
$k_j$ gives
\begin{equation}\label{eq:ns-continuity-dk}
  \frac{\partial}{\partial k_j}\left( k_i \hat{u}_i \right)
  = \hat{u}_j + k_i \frac{\partial \hat{u}_i}{\partial k_j} = 0
  \quad\Longrightarrow\quad
  k_i \frac{\partial \hat{u}_i}{\partial k_j} = -\hat{u}_j,
\end{equation}
so that $k_i k_j \partial \hat{u}_i / \partial k_j = -k_j \hat{u}_j = 0$.
Hence the scaling term is divergence free on its own, and
\eqref{eq:ns-pressure-contracted} reduces to a Poisson equation for the
pressure,
\begin{equation}\label{eq:ns-fourier-poisson}
  \mathrm{i} k^2 \hat{p} = -k_i \hat{N}_i
  \quad\Longrightarrow\quad
  \hat{p} = \mathrm{i}\,\frac{k_l \hat{N}_l}{k^2},
  \qquad k \neq 0,
\end{equation}
with $\hat{p}$ at $k = 0$ fixed arbitrarily, since only its gradient enters
the momentum equation. Substituting
\eqref{eq:ns-fourier-poisson} into \eqref{eq:ns-nondim-momentum-fourier},
the pressure term becomes
\begin{equation}\label{eq:ns-fourier-pressure-substituted}
  -\mathrm{i} k_i \hat{p} = \frac{k_i k_l}{k^2} \hat{N}_l,
\end{equation}
which combines with $-\hat{N}_i$ to give the solenoidal projection of the
convective term. Defining the projection tensor
\begin{equation}\label{eq:ns-projection-tensor}
  P_{il}(\mathbf{k}) = \delta_{il} - \frac{k_i k_l}{k^2},
\end{equation}
the evolution equation is
\begin{equation}\label{eq:ns-fourier-final}
  \frac{\partial \hat{u}_i}{\partial t}
  = \underbrace{-\frac{L^\prime}{L} \left( k_j \frac{\partial \hat{u}_i}{\partial k_j} + 3\, \hat{u}_i \right)
  - \frac{U^\prime}{U} \hat{u}_i}_{\text{scaling term}}
  \underbrace{- P_{il}(\mathbf{k})\, \hat{N}_l
  - \Delta \cdot k^2 \hat{u}_i}_{\text{NS term}} 
\end{equation}
