\section{Governing Equation}

Define
\begin{equation}\label{eq:alpha}
  \alpha = \frac{\mathrm{d} \ln g}{\mathrm{d} t}
\end{equation}
and
\begin{equation}\label{eq:beta}
  \beta = \frac{\mathrm{d} \ln f}{\mathrm{d} t}.
\end{equation}
The governing equation to be solved is
\begin{equation}\label{eq:governing}
  \frac{\partial u}{\partial t}
  = \alpha x \frac{\partial u}{\partial x}
  - \beta u
  + \frac{\partial^2 u}{\partial x^2}.
\end{equation}

\section{Integration}

Integrating \eqref{eq:governing} in time over a step $[t_k, t_{k+1}]$, with
$t_{k+1} = t_k + \Delta t$, gives
\begin{equation}\label{eq:split}
  u_{k+1}
  = \underbrace{u_k + \int_{t_k}^{t_{k+1}} \frac{\partial^2 u}{\partial x^2} \, \mathrm{d}t}_{y_1}
  + \underbrace{\int_{t_k}^{t_{k+1}} \alpha x \frac{\partial u}{\partial x} \, \mathrm{d}t}_{y_2}
  - \underbrace{\int_{t_k}^{t_{k+1}} \beta u \, \mathrm{d}t}_{y_3}.
\end{equation}
Each increment $y_i$ is evaluated below by solving its own sub-problem from the
common initial condition $u_k$; this is a Lie splitting, and is first-order
accurate in $\Delta t$. The diffusive term $y_1$ has no closed form and is
advanced with any integration method of choice. The remaining two increments are
available in closed form.

\subsection{\texorpdfstring{$y_2$}{y2}}

The function $u_k + y_2$ is the solution, at time $t_{k+1}$, of the PDE
\begin{equation}\label{eq:advection}
  \frac{\partial u}{\partial t} = \alpha x \frac{\partial u}{\partial x}.
\end{equation}
This PDE is solved with the method of characteristics, by finding a curve
$\bigl(x(t), t\bigr)$ along which
\begin{equation}
  \frac{\mathrm{d} u}{\mathrm{d} t}
  = \frac{\partial u}{\partial t}
  + \frac{\mathrm{d} x}{\mathrm{d} t} \frac{\partial u}{\partial x}
  = 0.
\end{equation}
Comparing with \eqref{eq:advection}, this requires that
\begin{equation}\label{eq:char}
  \frac{\mathrm{d} x}{\mathrm{d} t} = -\alpha x.
\end{equation}
Substituting \eqref{eq:alpha} into \eqref{eq:char} gives
$\mathrm{d} \ln x / \mathrm{d}t = -\,\mathrm{d} \ln g / \mathrm{d}t$, so
$x \cdot g = \mathrm{const}$ along a characteristic. It follows that
\begin{equation}
  x(t_{k+1}) \, g_{k+1} = x(t_k) \, g_k,
  \qquad \text{that is} \qquad
  x(t_k) = x(t_{k+1}) \, \tilde{g}_{k+1},
\end{equation}
where
\begin{equation}\label{eq:gtilde}
  \tilde{g}_{k+1} = \frac{g_{k+1}}{g_k}.
\end{equation}
Because $u$ is constant along $x(t)$, tracing the characteristic through the
point $x$ back to $t_k$ gives
\begin{equation}
  u_{k+1}(x) = u_k\bigl(x \, \tilde{g}_{k+1}\bigr),
\end{equation}
and therefore
\begin{equation}\label{eq:y2}
  y_2(x) = u_k\bigl(x \, \tilde{g}_{k+1}\bigr) - u_k(x).
\end{equation}

\subsection{\texorpdfstring{$y_3$}{y3}}

Let $v$ be the solution of the reaction sub-problem
\begin{equation}\label{eq:reaction}
  \frac{\partial v}{\partial t} = \beta v,
  \qquad v(t_k) = u_k,
\end{equation}
so that $y_3 = v(t_{k+1}) - u_k$. Substituting \eqref{eq:beta} into
\eqref{eq:reaction} and integrating over the step gives
\begin{equation}
  \ln \left( \frac{v(t_{k+1})}{u_k} \right) = \ln \left( \frac{f_{k+1}}{f_k} \right),
\end{equation}
so that $v(t_{k+1}) = \tilde{f}_{k+1} u_k$ and
\begin{equation}\label{eq:y3}
  y_3(x) = \bigl( \tilde{f}_{k+1} - 1 \bigr) u_k(x),
  \qquad \text{where} \qquad
  \tilde{f}_{k+1} = \frac{f_{k+1}}{f_k}.
\end{equation}

\subsection{Combining Terms}

Substituting \eqref{eq:y2} and \eqref{eq:y3} into \eqref{eq:split},
\begin{equation}
  u_{k+1}(x)
  = y_1(x)
  + \Bigl[ u_k\bigl(x \, \tilde{g}_{k+1}\bigr) - u_k(x) \Bigr]
  - \Bigl[ \bigl( \tilde{f}_{k+1} - 1 \bigr) u_k(x) \Bigr],
\end{equation}
and the two bare $u_k(x)$ terms cancel, leaving
\begin{equation}\label{eq:update}
  u_{k+1}(x)
  = y_1(x)
  + u_k\bigl(x \, \tilde{g}_{k+1}\bigr)
  - \tilde{f}_{k+1} \, u_k(x).
\end{equation}

We now choose $\tilde{g}_{k+1}$ and $\tilde{f}_{k+1}$ so that the zeroth and
first moments are conserved across the step. Write the moments of the solution
at step $k$ as
\begin{equation}\label{eq:moments}
  M_0^{k} = \int_{-\infty}^{\infty} u_k(x) \, \mathrm{d}x,
  \qquad
  M_1^{k} = \int_{-\infty}^{\infty} x \, u_k(x) \, \mathrm{d}x,
\end{equation}
and let $M_0^{(y_1)}$ and $M_1^{(y_1)}$ denote the same two moments of $y_1$.
Conserving $M_0$ and $M_1$ together is equivalent to conserving the mass and the
centroid $M_1 / M_0$, since the normalising factor is itself held fixed. The
conditions to be imposed are therefore
\begin{equation}\label{eq:conservation}
  M_0^{k+1} = M_0^{k},
  \qquad
  M_1^{k+1} = M_1^{k}.
\end{equation}
Throughout, $\tilde{g}_{k+1} > 0$, so the change of variables below preserves the
orientation of the integrals.

\subsubsection{Zeroth Moment}

Taking the zeroth moment of \eqref{eq:update} gives
\begin{equation}\label{eq:m0-split}
  M_0^{k+1} - M_0^{(y_1)}
  = \int_{-\infty}^{\infty} u_k\bigl(x \, \tilde{g}_{k+1}\bigr) \, \mathrm{d}x
  - \int_{-\infty}^{\infty} \tilde{f}_{k+1} \, u_k(x) \, \mathrm{d}x.
\end{equation}
The first integral is evaluated with the change of variables
$z = \tilde{g}_{k+1} x$, for which $\mathrm{d}x = \mathrm{d}z / \tilde{g}_{k+1}$,
\begin{equation}
  \int_{-\infty}^{\infty} u_k\bigl(x \, \tilde{g}_{k+1}\bigr) \, \mathrm{d}x
  = \frac{1}{\tilde{g}_{k+1}} \int_{-\infty}^{\infty} u_k(z) \, \mathrm{d}z
  = \frac{M_0^{k}}{\tilde{g}_{k+1}}.
\end{equation}
The second integral is simply
\begin{equation}
  \int_{-\infty}^{\infty} \tilde{f}_{k+1} \, u_k(x) \, \mathrm{d}x
  = \tilde{f}_{k+1} M_0^{k}.
\end{equation}
Together, and imposing $M_0^{k+1} = M_0^{k}$ from \eqref{eq:conservation},
\begin{equation}\label{eq:m0}
  M_0^{k} - M_0^{(y_1)}
  = \left( \frac{1}{\tilde{g}_{k+1}} - \tilde{f}_{k+1} \right) M_0^{k}.
\end{equation}

\subsubsection{First Moment}

Taking the first moment of \eqref{eq:update} gives
\begin{equation}\label{eq:m1-split}
  M_1^{k+1} - M_1^{(y_1)}
  = \int_{-\infty}^{\infty} x \, u_k\bigl(x \, \tilde{g}_{k+1}\bigr) \, \mathrm{d}x
  - \int_{-\infty}^{\infty} x \, \tilde{f}_{k+1} \, u_k(x) \, \mathrm{d}x.
\end{equation}
The same change of variables $z = \tilde{g}_{k+1} x$ now contributes a second
factor of $\tilde{g}_{k+1}$ through $x = z / \tilde{g}_{k+1}$,
\begin{equation}
  \int_{-\infty}^{\infty} x \, u_k\bigl(x \, \tilde{g}_{k+1}\bigr) \, \mathrm{d}x
  = \frac{1}{\tilde{g}_{k+1}^{\,2}} \int_{-\infty}^{\infty} z \, u_k(z) \, \mathrm{d}z
  = \frac{M_1^{k}}{\tilde{g}_{k+1}^{\,2}}.
\end{equation}
The second integral is simply
\begin{equation}
  \int_{-\infty}^{\infty} x \, \tilde{f}_{k+1} \, u_k(x) \, \mathrm{d}x
  = \tilde{f}_{k+1} M_1^{k}.
\end{equation}
Together, and imposing $M_1^{k+1} = M_1^{k}$ from \eqref{eq:conservation},
\begin{equation}\label{eq:m1}
  M_1^{k} - M_1^{(y_1)}
  = \left( \frac{1}{\tilde{g}_{k+1}^{\,2}} - \tilde{f}_{k+1} \right) M_1^{k}.
\end{equation}

\subsubsection{Solving for the Step Parameters}

Equations \eqref{eq:m0} and \eqref{eq:m1} are two conditions on the two unknowns
$\tilde{g}_{k+1}$ and $\tilde{f}_{k+1}$. It is convenient to work with the
moment ratios
\begin{equation}\label{eq:ratios}
  r_0 = \frac{M_0^{(y_1)}}{M_0^{k}},
  \qquad
  r_1 = \frac{M_1^{(y_1)}}{M_1^{k}},
\end{equation}
which measure how much of each moment the diffusive update $y_1$ already
carries, and with the reciprocal scaling
\begin{equation}\label{eq:adef}
  a = \frac{1}{\tilde{g}_{k+1}}.
\end{equation}
Dividing \eqref{eq:m0} by $M_0^{k}$ and \eqref{eq:m1} by $M_1^{k}$ turns the
system into
\begin{align}
  a - \tilde{f}_{k+1} &= 1 - r_0, \label{eq:sys0} \\
  a^2 - \tilde{f}_{k+1} &= 1 - r_1. \label{eq:sys1}
\end{align}
The unknown $\tilde{f}_{k+1}$ enters both equations identically, so subtracting
\eqref{eq:sys0} from \eqref{eq:sys1} eliminates it and leaves a single quadratic
in $a$,
\begin{equation}\label{eq:quadratic}
  a^2 - a - (r_0 - r_1) = 0,
\end{equation}
whose roots are
\begin{equation}\label{eq:aroots}
  a = \frac{1 \pm S}{2},
  \qquad
  S = \sqrt{1 + 4(r_0 - r_1)}.
\end{equation}
The root is fixed by the case of vanishing diffusion, for which $y_1 = u_k$ and
hence $r_0 = r_1 = 1$ and $S = 1$. The step must then be the identity,
$\tilde{g}_{k+1} = 1$, so $a = 1$; the negative root gives $a = 0$ instead, at
which $\tilde{g}_{k+1}$ is undefined. Taking the positive root and inverting
\eqref{eq:adef},
\begin{equation}\label{eq:gsol}
  \tilde{g}_{k+1} = \frac{2}{1 + S}.
\end{equation}
Back-substituting $a = (1 + S)/2$ into \eqref{eq:sys0} gives
\begin{equation}\label{eq:fsol}
  \tilde{f}_{k+1} = a - 1 + r_0 = r_0 + \frac{S - 1}{2}.
\end{equation}
Equations \eqref{eq:gsol} and \eqref{eq:fsol} determine the step from the
moments of $y_1$ alone. Two conditions are worth noting. The radicand of $S$
must be non-negative,
\begin{equation}\label{eq:discriminant}
  r_0 - r_1 \geq -\tfrac{1}{4},
\end{equation}
which bounds how far the diffusive update may move the first moment relative to
the zeroth before no real, moment-conserving step exists. When
\eqref{eq:discriminant} holds, $S \geq 0$ gives $a \geq \tfrac{1}{2}$, so the
positive root automatically satisfies the requirement $\tilde{g}_{k+1} > 0$
assumed in \eqref{eq:m0-split}, with $\tilde{g}_{k+1} \leq 2$.

